{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/signatures/rsa-pkcs1-v1-5.json",
  "title": "RSA PKCS#1 v1.5 signature configuration",
  "description": "Legacy RSA signature padding configuration. Prefer RSA-PSS for new signatures.",
  "type": "object",
  "properties": {
    "algorithm": { "const": "RSASSA-PKCS1-v1_5" },
    "private_key_ref": { "type": "string", "minLength": 1 },
    "public_key_ref": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "enum": ["SHA-256", "SHA-384", "SHA-512"] },
    "encoding": { "type": "string", "enum": ["base64url", "base64", "hex"] }
  },
  "required": ["algorithm", "private_key_ref", "public_key_ref", "hash", "encoding"],
  "additionalProperties": false,
  "examples": [{ "algorithm": "RSASSA-PKCS1-v1_5", "private_key_ref": "vault://keys/signing-private", "public_key_ref": "vault://keys/signing-public", "hash": "SHA-256", "encoding": "base64url" }]
}