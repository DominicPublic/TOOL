{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/encryption/chacha20-poly1305.json",
  "title": "ChaCha20-Poly1305 encryption configuration",
  "description": "Configuration for authenticated encryption with ChaCha20-Poly1305.",
  "type": "object",
  "properties": {
    "algorithm": { "const": "ChaCha20-Poly1305" },
    "key_ref": { "type": "string", "minLength": 1 },
    "nonce_bytes": { "type": "integer", "const": 12 },
    "tag_bytes": { "type": "integer", "const": 16 }
  },
  "required": ["algorithm", "key_ref", "nonce_bytes", "tag_bytes"],
  "additionalProperties": false,
  "examples": [{ "algorithm": "ChaCha20-Poly1305", "key_ref": "vault://keys/service-data", "nonce_bytes": 12, "tag_bytes": 16 }]
}