{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/compression/gzip.json",
  "title": "gzip stream configuration",
  "description": "gzip framing with a DEFLATE payload. Decompression consumers should enforce output size and expansion-ratio limits.",
  "type": "object",
  "properties": {
    "algorithm": { "const": "gzip" },
    "level": { "type": "integer", "minimum": 0, "maximum": 9 },
    "mtime": { "type": "integer", "minimum": 0 },
    "include_filename": { "type": "boolean" }
  },
  "required": ["algorithm", "level"],
  "additionalProperties": false,
  "examples": [{ "algorithm": "gzip", "level": 6, "mtime": 0, "include_filename": false }]
}