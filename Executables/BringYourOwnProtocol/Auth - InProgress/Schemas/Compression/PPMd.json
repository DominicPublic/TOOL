{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/compression/ppmd.json",
  "title": "PPMd compression configuration",
  "description": "Prediction by partial matching settings. Decompression consumers should enforce output size, memory, and processing-time limits.",
  "type": "object",
  "properties": {
    "algorithm": { "const": "PPMd" },
    "variant": { "type": "string", "enum": ["I", "H", "J"] },
    "order": { "type": "integer", "minimum": 2, "maximum": 16 },
    "memory_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 }
  },
  "required": ["algorithm", "variant", "order", "memory_bytes"],
  "additionalProperties": false,
  "examples": [{ "algorithm": "PPMd", "variant": "I", "order": 8, "memory_bytes": 67108864 }]
}