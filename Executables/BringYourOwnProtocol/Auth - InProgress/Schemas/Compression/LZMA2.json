{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/compression/lzma2.json",
  "title": "LZMA2 compression configuration",
  "description": "LZMA2 encoder settings. Decompression consumers should enforce output size and expansion-ratio limits.",
  "type": "object",
  "properties": {
    "algorithm": { "const": "LZMA2" },
    "preset": { "type": "integer", "minimum": 0, "maximum": 9 },
    "dictionary_bytes": { "type": "integer", "minimum": 4096 },
    "threads": { "type": "integer", "minimum": 1 }
  },
  "required": ["algorithm", "preset"],
  "additionalProperties": false,
  "examples": [{ "algorithm": "LZMA2", "preset": 6, "dictionary_bytes": 8388608, "threads": 2 }]
}