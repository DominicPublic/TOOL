{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/network/http-1.1.json",
  "title": "HTTP/1.1 service configuration",
  "description": "Representative HTTP/1.1 listener configuration.",
  "type": "object",
  "properties": {
    "protocol": { "const": "HTTP" },
    "version": { "const": "1.1" },
    "listen_address": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "tls_enabled": { "type": "boolean" },
    "keep_alive_timeout_seconds": { "type": "integer", "minimum": 0 }
  },
  "required": ["protocol", "version", "listen_address", "port", "tls_enabled"],
  "additionalProperties": false,
  "examples": [{ "protocol": "HTTP", "version": "1.1", "listen_address": "0.0.0.0", "port": 443, "tls_enabled": true, "keep_alive_timeout_seconds": 60 }]
}