{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/network/sftp.json",
  "title": "SFTP connection configuration",
  "description": "SSH File Transfer Protocol client configuration with strict host-key verification.",
  "type": "object",
  "properties": {
    "protocol": { "const": "SFTP" },
    "host": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "const": 22 },
    "username": { "type": "string", "minLength": 1 },
    "private_key_ref": { "type": "string", "minLength": 1 },
    "host_key_ref": { "type": "string", "minLength": 1 },
    "strict_host_key_checking": { "const": true }
  },
  "required": ["protocol", "host", "port", "username", "host_key_ref", "strict_host_key_checking"],
  "additionalProperties": false,
  "examples": [{ "protocol": "SFTP", "host": "files.example.com", "port": 22, "username": "transfer", "private_key_ref": "vault://sftp/client-key", "host_key_ref": "vault://sftp/known-host", "strict_host_key_checking": true }]
}