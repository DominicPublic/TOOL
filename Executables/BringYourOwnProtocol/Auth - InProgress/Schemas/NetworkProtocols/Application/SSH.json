{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/network/ssh.json",
  "title": "SSH client connection configuration",
  "description": "Secure Shell client configuration with strict host-key verification.",
  "type": "object",
  "properties": {
    "protocol": { "const": "SSH" },
    "host": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "const": 22 },
    "username": { "type": "string", "minLength": 1 },
    "host_key_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "strict_host_key_checking": { "const": true },
    "private_key_ref": { "type": "string", "minLength": 1 }
  },
  "required": ["protocol", "host", "port", "username", "host_key_refs", "strict_host_key_checking"],
  "additionalProperties": false,
  "examples": [{ "protocol": "SSH", "host": "server.example.com", "port": 22, "username": "deploy", "host_key_refs": ["vault://ssh/known-hosts/server"], "strict_host_key_checking": true, "private_key_ref": "vault://ssh/deploy-key" }]
}