{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/network/icmpv6.json",
  "title": "ICMPv6 policy configuration",
  "description": "Representative policy for ICMPv6 message handling; required neighbor-discovery traffic must remain permitted.",
  "type": "object",
  "properties": {
    "protocol": { "const": "ICMPv6" },
    "allowed_types": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "uniqueItems": true },
    "rate_limit_per_second": { "type": "integer", "minimum": 1 },
    "allow_neighbor_discovery": { "const": true },
    "allow_echo_request": { "type": "boolean" }
  },
  "required": ["protocol", "allowed_types", "rate_limit_per_second", "allow_neighbor_discovery", "allow_echo_request"],
  "additionalProperties": false,
  "examples": [{ "protocol": "ICMPv6", "allowed_types": [1, 2, 3, 128, 129, 135], "rate_limit_per_second": 10, "allow_neighbor_discovery": true, "allow_echo_request": true }]
}