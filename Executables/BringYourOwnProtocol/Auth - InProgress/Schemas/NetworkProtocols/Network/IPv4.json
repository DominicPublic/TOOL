{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/network/ipv4.json",
  "title": "IPv4 interface configuration",
  "description": "Representative IPv4 interface addressing configuration.",
  "type": "object",
  "properties": {
    "protocol": { "const": "IPv4" },
    "address_mode": { "type": "string", "enum": ["static", "dhcp"] },
    "addresses": { "type": "array", "items": { "type": "object", "properties": { "address": { "type": "string", "format": "ipv4" }, "prefix_length": { "type": "integer", "minimum": 0, "maximum": 32 } }, "required": ["address", "prefix_length"], "additionalProperties": false } },
    "gateway": { "type": "string", "format": "ipv4" },
    "dns_resolvers": { "type": "array", "items": { "type": "string", "format": "ipv4" } },
    "mtu": { "type": "integer", "minimum": 576, "maximum": 9000 }
  },
  "required": ["protocol", "address_mode"],
  "additionalProperties": false,
  "examples": [{ "protocol": "IPv4", "address_mode": "static", "addresses": [{ "address": "192.0.2.10", "prefix_length": 24 }], "gateway": "192.0.2.1", "dns_resolvers": ["192.0.2.53"], "mtu": 1500 }]
}